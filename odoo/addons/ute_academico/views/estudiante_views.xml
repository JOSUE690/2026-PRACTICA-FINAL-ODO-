<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ute_estudiante_list" model="ir.ui.view">
        <field name="name">ute.estudiante.list</field>
        <field name="model">ute.estudiante</field>
        <field name="arch" type="xml">
            <list string="Estudiantes">
                <field name="cedula"/>
                <field name="name"/>
                <field name="carrera_id"/>
                <field name="estado"/>
            </list>
        </field>
    </record>

    <record id="view_ute_estudiante_form" model="ir.ui.view">
        <field name="name">ute.estudiante.form</field>
        <field name="model">ute.estudiante</field>
        <field name="arch" type="xml">
            <form string="Estudiante">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="cedula"/>
                        <field name="email"/>
                        <field name="telefono"/>
                        <field name="fecha_nacimiento"/>
                        <field name="edad"/>
                        <field name="genero"/>
                        <field name="carrera_id"/>
                        <field name="modalidad"/>
                        <field name="fecha_ingreso"/>
                        <field name="estado"/>
                        <field name="notas"/>
                    </group>
                    <notebook>
                        <page string="Matrículas">
                            <field name="matricula_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="asignatura"/>
                                    <field name="periodo"/>
                                    <field name="estado"/>
                                    <field name="total"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ute_estudiante" model="ir.actions.act_window">
        <field name="name">Estudiantes</field>
        <field name="res_model">ute.estudiante</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>