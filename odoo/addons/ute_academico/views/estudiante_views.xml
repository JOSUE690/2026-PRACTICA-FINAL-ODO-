<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ute_estudiante_list" model="ir.ui.view">
        <field name="name">ute.estudiante.list</field>
        <field name="model">ute.estudiante</field>
        <field name="arch" type="xml">
            <list string="Estudiantes">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_ute_estudiante_form" model="ir.ui.view">
        <field name="name">ute.estudiante.form</field>
        <field name="model">ute.estudiante</field>
        <field name="arch" type="xml">
            <form string="Estudiante">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ute_estudiante" model="ir.actions.act_window">
        <field name="name">Estudiantes</field>
        <field name="res_model">ute.estudiante</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
