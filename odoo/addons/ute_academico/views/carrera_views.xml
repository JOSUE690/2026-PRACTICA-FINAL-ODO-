<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ute_carrera_list" model="ir.ui.view">
        <field name="name">ute.carrera.list</field>
        <field name="model">ute.carrera</field>
        <field name="arch" type="xml">
            <list string="Carreras">
                <field name="codigo"/>
                <field name="name"/>
                <field name="modalidad"/>
                <field name="total_estudiantes"/>
                <field name="activa"/>
            </list>
        </field>
    </record>

    <record id="view_ute_carrera_form" model="ir.ui.view">
        <field name="name">ute.carrera.form</field>
        <field name="model">ute.carrera</field>
        <field name="arch" type="xml">
            <form string="Carrera">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="codigo"/>
                        <field name="modalidad"/>
                        <field name="duracion_semestres"/>
                        <field name="cupo_maximo"/>
                        <field name="activa"/>
                        <field name="total_estudiantes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ute_carrera" model="ir.actions.act_window">
        <field name="name">Carreras</field>
        <field name="res_model">ute.carrera</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>