<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ute_matricula_list" model="ir.ui.view">
        <field name="name">ute.matricula.list</field>
        <field name="model">ute.matricula</field>
        <field name="arch" type="xml">
            <list string="Matrículas">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_ute_matricula_form" model="ir.ui.view">
        <field name="name">ute.matricula.form</field>
        <field name="model">ute.matricula</field>
        <field name="arch" type="xml">
            <form string="Matrícula">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ute_matricula" model="ir.actions.act_window">
        <field name="name">Matrículas</field>
        <field name="res_model">ute.matricula</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
